---
import { Font } from "astro:assets"
import "../styles/global.css"

interface Props {
    title?: string
    description?: string
    noindex?: boolean
}

const {
    title = "Nexus Data Labs | Coordination Through Data",
    description = "Helping people coordinate better by making data easy to use.",
    noindex = false,
} = Astro.props

const canonicalPath = Astro.url.pathname
    .replace(/\/index\.html$/, "/")
    .replace(/\.html$/, "")
const pageUrl = new URL(canonicalPath, Astro.site)
const imageUrl = new URL("/banner.png", Astro.site)
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta
            name="theme-color"
            content="#ffffff"
            media="(prefers-color-scheme: light)"
        />
        <meta
            name="theme-color"
            content="#000000"
            media="(prefers-color-scheme: dark)"
        />
        <Font
            cssVariable="--font-jetbrains-mono"
            preload={[
                { weight: 400, style: "normal" },
                { weight: 700, style: "normal" },
                { weight: 400, style: "italic" },
            ]}
        />
        <title>{title}</title>
        <meta name="description" content={description} />
        {noindex && <meta name="robots" content="noindex, nofollow" />}
        <link rel="canonical" href={pageUrl} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={pageUrl} />
        <meta property="og:image" content={imageUrl} />
        <meta property="og:type" content="website" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageUrl} />
    </head>
    <body>
        <a class="skip-link" href="#main-content">Skip to content</a>

        <main id="main-content" tabindex="-1">
            <slot />
        </main>
    </body>
</html>
